# Copy this file to .env and adjust the values.
NODE_ENV=development
PORT=3000

# Matches the Postgres service in docker-compose.yml
DATABASE_URL=postgres://movies:movies@localhost:5432/movies

# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional token lifetimes (defaults: 15 minutes, 7 days)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7

# Optional: login for the admin created by `npm run db:seed`
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=admin-password
