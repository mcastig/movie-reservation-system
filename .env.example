# Copy this file to .env and adjust the values.
NODE_ENV=development
PORT=3000

# Matches the Postgres service in docker-compose.yml
DATABASE_URL=postgres://movies:movies@localhost:5432/movies

# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Optional token lifetimes (defaults: 15 minutes, 7 days)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7

# Optional: minutes to clean a hall between showtimes (default 15)
# CLEANING_BUFFER_MINUTES=15

# Optional: the cinema's timezone, used to decide which showtimes are "on" a date (default UTC)
# THEATER_TIMEZONE=America/Mexico_City

# Optional: log level (fatal, error, warn, info, debug, trace, silent; default info)
# LOG_LEVEL=debug

# Optional: browser origins allowed to call the API, comma-separated (default: none)
# CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Optional: requests per IP per minute to the whole API (default 300)
# API_RATE_LIMIT_MAX=300

# Optional: requests to /auth/* allowed per IP per window (defaults: 20 per 15 minutes)
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Optional: number of proxies in front of the app, so rate limits see the client's
# real IP. 0 locally (default); 1 on Render, Railway, Fly.io...
# TRUST_PROXY_HOPS=0

# Optional: login for the admin created by `npm run db:seed`
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=admin-password
