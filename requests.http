# Sample requests for the VS Code "REST Client" extension (click "Send Request").
# Bruno and Postman can import or copy these too.
@base = http://localhost:3000
# Send "Log in as admin" first: the write requests below reuse its token.
@admin = Bearer {{adminLogin.response.body.accessToken}}

### Health
GET {{base}}/health

### --- Auth ---

### Sign up (always creates a regular user)
POST {{base}}/auth/signup
Content-Type: application/json

{ "email": "ana@example.com", "password": "correct-horse", "name": "Ana" }

### Log in as admin
# @name adminLogin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "admin@example.com", "password": "admin-password" }

### Log in as the demo user
# @name userLogin
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "user@example.com", "password": "user-password" }

### Who am I?
GET {{base}}/me
Authorization: Bearer {{userLogin.response.body.accessToken}}

### Exchange the refresh token for a new pair (works once per token)
POST {{base}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{userLogin.response.body.refreshToken}}" }

### Log out (revokes the refresh token)
POST {{base}}/auth/logout
Content-Type: application/json

{ "refreshToken": "{{userLogin.response.body.refreshToken}}" }

### Promote user 2 to admin (admin only)
PATCH {{base}}/users/2/role
Authorization: {{admin}}
Content-Type: application/json

{ "role": "admin" }

### 403: a regular user trying to create a movie
POST {{base}}/movies
Authorization: Bearer {{userLogin.response.body.accessToken}}
Content-Type: application/json

{ "title": "Nope", "description": "Not allowed", "durationMinutes": 90 }

### --- Genres ---

### List genres
GET {{base}}/genres

### Create a genre
POST {{base}}/genres
Authorization: {{admin}}
Content-Type: application/json

{ "name": "Thriller" }

### --- Movies ---

### List movies (paginated, optional ?genre=<id>)
GET {{base}}/movies?page=1&limit=20

### Movies in one genre
GET {{base}}/movies?genre=3

### Get one movie
GET {{base}}/movies/1

### Create a movie
POST {{base}}/movies
Authorization: {{admin}}
Content-Type: application/json

{
  "title": "Arrival",
  "description": "A linguist is recruited to talk with alien visitors.",
  "posterUrl": "https://example.com/posters/arrival.jpg",
  "durationMinutes": 116,
  "genreIds": [3, 4]
}

### Update some fields (genreIds replaces the whole list)
PATCH {{base}}/movies/4
Authorization: {{admin}}
Content-Type: application/json

{ "title": "Arrival (2016)", "genreIds": [4] }

### Delete a movie (409 if it has showtimes, like movie 1)
DELETE {{base}}/movies/4
Authorization: {{admin}}

### --- Showtimes ---
# Times must include a timezone: "Z" (UTC) or an offset like "-06:00".
# The seed schedules showtimes for the next 3 days; pick a date after them.

### Get one showtime (public)
GET {{base}}/showtimes/1

### Create a showtime (ends_at = start + duration + cleaning buffer)
POST {{base}}/showtimes
Authorization: {{admin}}
Content-Type: application/json

{ "movieId": 3, "hallId": 2, "startsAt": "2030-01-15T20:00:00Z", "priceCents": 1100 }

### 409 HALL_BUSY: same hall, overlapping time (send the one above first)
POST {{base}}/showtimes
Authorization: {{admin}}
Content-Type: application/json

{ "movieId": 1, "hallId": 2, "startsAt": "2030-01-15T21:00:00Z", "priceCents": 1100 }

### Same time in another hall is fine
POST {{base}}/showtimes
Authorization: {{admin}}
Content-Type: application/json

{ "movieId": 1, "hallId": 1, "startsAt": "2030-01-15T21:00:00Z", "priceCents": 1100 }

### Change only the price (always allowed before it starts)
PATCH {{base}}/showtimes/1
Authorization: {{admin}}
Content-Type: application/json

{ "priceCents": 1300 }

### 409: showtime 1 has a reservation, so it can't move
PATCH {{base}}/showtimes/1
Authorization: {{admin}}
Content-Type: application/json

{ "startsAt": "2030-01-16T18:00:00Z" }

### 409: can't delete a showtime that has reservations
DELETE {{base}}/showtimes/1
Authorization: {{admin}}

### --- Errors to try ---

### 400: several validation problems at once
POST {{base}}/movies
Authorization: {{admin}}
Content-Type: application/json

{ "title": "", "durationMinutes": -5, "posterUrl": "javascript:alert(1)" }

### 400: malformed JSON
POST {{base}}/movies
Authorization: {{admin}}
Content-Type: application/json

{ "title":
